{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/publications",
  "version": "0.1.0",
  "title": "publications",
  "category": "widgets",
  "icon": "book",
  "description": "List of publications",
  "example": {},
  "supports": {
    "html": false
  },
  "attributes": {
    "selectedTags": {
      "type": "array",
      "default": []
    },
    "matchAllTags": {
      "type": "boolean",
      "default": "false"
    },
    "showYearTimeline": {
      "type": "boolean",
      "default": true
    },
    "showYearHeadings": {
      "type": "boolean",
      "default": true
    },
    "maxPublications": {
      "type": "number",
      "default": 0
    }
  },
  "textdomain": "publications",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}